{
  "name": "pi-durable-ahp",
  "version": "0.1.0",
  "description": "Agent Host Protocol host for pi-durable: each conversation a session, its subagents chats beside it",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.29.1",
  "dependencies": {
    "@microsoft/agent-host-protocol": "1.1.0",
    "ws": "8.18.3"
  },
  "peerDependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
