{
  "name": "pi-durable-ahp",
  "version": "0.1.0",
  "description": "The Agent Host Protocol for pi-durable: each conversation a session, its subagents chats beside it, ACP agents (Claude Code, Gemini CLI) as sessions too, and pi's own TUI as a session anyone can attach to",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "pi"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "packageManager": "pnpm@10.29.1",
  "dependencies": {
    "@agentclientprotocol/sdk": "2.2.0",
    "@microsoft/agent-host-protocol": "1.1.0",
    "ws": "8.18.3"
  },
  "peerDependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "bin": {
    "pi-durable-ahp": "./dist/bin.js"
  }
}
